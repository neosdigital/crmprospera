generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  OWNER
  ADMIN
  BROKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BrokerStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum LeadStatus {
  NEW
  WAITING_ASSIGNMENT
  ASSIGNED
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  SCHEDULED
  CONVERTED
  LOST
  EXPIRED
}

enum AssignmentStatus {
  ASSIGNED
  CONTACTED
  EXPIRED
  TRANSFERRED
}

enum AuditAction {
  LEAD_RECEIVED
  ASSIGNED
  EXPIRED
  CONTACTED
  TRANSFERRED
  STATUS_CHANGED
  CONVERTED
  LOST
  BROKER_UPDATED
  ROTATION_UPDATED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  INTEGRATION_ERROR
  WEBHOOK_RECEIVED
  WEBHOOK_DUPLICATE
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  WHATSAPP_SENT
  WHATSAPP_FAILED
  PUSH_SUBSCRIBED
  PUSH_UNSUBSCRIBED
}

// ============================================================
// CORE / TENANCY
// ============================================================

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  responseTimeoutMinutes  Int      @default(5) @map("response_timeout_minutes")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  users               User[]
  brokers             Broker[]
  leads               Lead[]
  leadAssignments     LeadAssignment[]
  rotationState       RotationState?
  metaIntegrations    MetaIntegration[]
  whatsappIntegration WhatsAppIntegration?
  auditLogs           AuditLog[]
  pushSubscriptions   PushSubscription[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  name           String
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           Role
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker            Broker?
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]

  @@index([organizationId])
  @@map("users")
}

model Broker {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  userId           String       @unique @map("user_id")
  displayName      String       @map("display_name")
  phone            String?
  rotationPosition Int          @map("rotation_position")
  status           BrokerStatus @default(ACTIVE)
  isInRotation     Boolean      @default(true) @map("is_in_rotation")
  pausedReason     String?      @map("paused_reason")
  soundEnabled     Boolean      @default(true) @map("sound_enabled")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadsCurrent     Lead[]           @relation("CurrentBroker")
  leadAssignments  LeadAssignment[]

  @@unique([organizationId, rotationPosition])
  @@index([organizationId])
  @@map("brokers")
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id              String     @id @default(cuid())
  organizationId  String     @map("organization_id")
  metaLeadId      String?    @unique @map("meta_lead_id")
  name            String
  phone           String?
  email           String?
  source          String     @default("meta_ads")
  platform        String?
  pageId          String?    @map("page_id")
  campaignId      String?    @map("campaign_id")
  campaignName    String?    @map("campaign_name")
  adsetId         String?    @map("adset_id")
  adsetName       String?    @map("adset_name")
  adId            String?    @map("ad_id")
  adName          String?    @map("ad_name")
  formId          String?    @map("form_id")
  formName        String?    @map("form_name")
  customFields    Json       @default("{}") @map("custom_fields")
  status          LeadStatus @default(NEW)
  notes           String?    @map("notes")
  currentBrokerId String?    @map("current_broker_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  firstContactAt  DateTime?  @map("first_contact_at")
  convertedAt     DateTime?  @map("converted_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentBroker Broker?         @relation("CurrentBroker", fields: [currentBrokerId], references: [id])
  assignments  LeadAssignment[]
  auditLogs    AuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, currentBrokerId])
  @@index([organizationId, createdAt])
  @@map("leads")
}

model LeadAssignment {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  leadId         String           @map("lead_id")
  brokerId       String           @map("broker_id")
  attemptNumber  Int              @map("attempt_number")
  assignedAt     DateTime         @default(now()) @map("assigned_at")
  expiresAt      DateTime         @map("expires_at")
  respondedAt    DateTime?        @map("responded_at")
  status         AssignmentStatus @default(ASSIGNED)
  responseType   String?          @map("response_type")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker       Broker       @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([leadId, attemptNumber])
  @@index([status, expiresAt])
  @@index([organizationId, brokerId])
  @@map("lead_assignments")
}

model RotationState {
  id              String   @id @default(cuid())
  organizationId  String   @unique @map("organization_id")
  currentPosition Int      @default(1) @map("current_position")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rotation_state")
}

// ============================================================
// META INTEGRATION
// ============================================================

model MetaIntegration {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  pageId                String    @map("page_id")
  pageName              String?   @map("page_name")
  accessTokenEncrypted  String    @map("access_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  isActive              Boolean   @default(true) @map("is_active")
  lastEventAt           DateTime? @map("last_event_at")
  lastLeadSyncAt        DateTime? @map("last_lead_sync_at")
  webhookVerifiedAt     DateTime? @map("webhook_verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pageId])
  @@map("meta_integrations")
}

// ============================================================
// WHATSAPP (Cloud API) — notificação de corretores
// ============================================================

model WhatsAppIntegration {
  id                    String    @id @default(cuid())
  organizationId        String    @unique @map("organization_id")
  phoneNumberId         String    @map("phone_number_id")
  displayPhoneNumber    String?   @map("display_phone_number")
  accessTokenEncrypted  String    @map("access_token_encrypted")
  isActive              Boolean   @default(true) @map("is_active")
  lastMessageAt         DateTime? @map("last_message_at")
  lastErrorAt           DateTime? @map("last_error_at")
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_integrations")
}

// ============================================================
// WEB PUSH — notificações mesmo com o CRM fechado (PWA)
// ============================================================

model PushSubscription {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?   @map("user_agent")
  lastSuccessAt  DateTime? @map("last_success_at")
  lastErrorAt    DateTime? @map("last_error_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  leadId         String?     @map("lead_id")
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String?     @map("entity_id")
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@map("audit_logs")
}
