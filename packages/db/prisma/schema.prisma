generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  OWNER
  ADMIN
  BROKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BrokerStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum LeadStatus {
  NEW
  WAITING_ASSIGNMENT
  ASSIGNED
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  SCHEDULED
  CONVERTED
  LOST
  EXPIRED
  REMARKETING
}

enum AssignmentStatus {
  ASSIGNED
  CONTACTED
  EXPIRED
  TRANSFERRED
}

enum AuditAction {
  LEAD_RECEIVED
  ASSIGNED
  EXPIRED
  CONTACTED
  TRANSFERRED
  STATUS_CHANGED
  CONVERTED
  LOST
  BROKER_UPDATED
  ROTATION_UPDATED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  INTEGRATION_ERROR
  WEBHOOK_RECEIVED
  WEBHOOK_DUPLICATE
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  WHATSAPP_SENT
  WHATSAPP_FAILED
  PUSH_SUBSCRIBED
  PUSH_UNSUBSCRIBED
  PUSH_SENT
  PUSH_FAILED
}

// ============================================================
// CORE / TENANCY
// ============================================================

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  responseTimeoutMinutes Int      @default(5) @map("response_timeout_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  users               User[]
  brokers             Broker[]
  leads               Lead[]
  leadAssignments     LeadAssignment[]
  rotationState       RotationState?
  metaIntegrations    MetaIntegration[]
  whatsappIntegration WhatsAppIntegration?
  auditLogs           AuditLog[]
  pushSubscriptions   PushSubscription[]
  leadNotes           LeadNote[]
  adAccountMonitor    AdAccountMonitor?

  // Área do Corretor (módulo isolado) — só relações, nenhuma coluna nova nesta tabela.
  brokerPersonalAccess  BrokerPersonalAccess[]
  brokerMetaConnections BrokerMetaConnection[]
  brokerMetaForms       BrokerMetaForm[]
  personalLeads         PersonalLead[]
  personalLeadNotes     PersonalLeadNote[]
  personalLeadEvents    PersonalLeadEvent[]
  brokerMetaSyncLogs    BrokerMetaSyncLog[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  name           String
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           Role
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker            Broker?
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  notesAuthored     LeadNote[]         @relation("LeadNoteAuthor")
  noteRevisions     LeadNoteRevision[] @relation("LeadNoteEditor")

  // Área do Corretor (módulo isolado) — só relações, nenhuma coluna nova nesta tabela.
  personalNotesAuthored PersonalLeadNote[]  @relation("PersonalLeadNoteAuthor")
  personalLeadEvents    PersonalLeadEvent[] @relation("PersonalLeadEventUser")

  @@index([organizationId])
  @@map("users")
}

model Broker {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  userId           String       @unique @map("user_id")
  displayName      String       @map("display_name")
  phone            String?
  rotationPosition Int          @map("rotation_position")
  status           BrokerStatus @default(ACTIVE)
  isInRotation     Boolean      @default(true) @map("is_in_rotation")
  pausedReason     String?      @map("paused_reason")
  soundEnabled     Boolean      @default(true) @map("sound_enabled")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadsCurrent    Lead[]           @relation("CurrentBroker")
  leadAssignments LeadAssignment[]

  // Área do Corretor (módulo isolado) — só relações, nenhuma coluna nova nesta tabela.
  personalAccess        BrokerPersonalAccess?
  brokerMetaConnections BrokerMetaConnection[]
  personalLeads         PersonalLead[]

  @@unique([organizationId, rotationPosition])
  @@index([organizationId])
  @@map("brokers")
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id                  String     @id @default(cuid())
  organizationId      String     @map("organization_id")
  metaLeadId          String?    @unique @map("meta_lead_id")
  name                String
  phone               String?
  email               String?
  source              String     @default("meta_ads")
  platform            String?
  pageId              String?    @map("page_id")
  campaignId          String?    @map("campaign_id")
  campaignName        String?    @map("campaign_name")
  adsetId             String?    @map("adset_id")
  adsetName           String?    @map("adset_name")
  adId                String?    @map("ad_id")
  adName              String?    @map("ad_name")
  formId              String?    @map("form_id")
  formName            String?    @map("form_name")
  customFields        Json       @default("{}") @map("custom_fields")
  status              LeadStatus @default(NEW)
  notes               String?    @map("notes")
  currentBrokerId     String?    @map("current_broker_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  firstContactAt      DateTime?  @map("first_contact_at")
  convertedAt         DateTime?  @map("converted_at")
  /// Lead em "Perdidos" com retorno agendado: nessa data/hora volta sozinho para a roleta
  /// (ver returnDueLostLeads em rotation.ts). Nulo fora de LOST ou sem retorno agendado.
  returnToRotationAt  DateTime?  @map("return_to_rotation_at")
  /// Lead em "Remarketing" com lembrete agendado: nessa data/hora o corretor que está com o
  /// lead recebe de novo uma notificação (ver sendDueRemarketingReminders em rotation.ts).
  remarketingNotifyAt DateTime?  @map("remarketing_notify_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentBroker Broker?          @relation("CurrentBroker", fields: [currentBrokerId], references: [id])
  assignments   LeadAssignment[]
  auditLogs     AuditLog[]
  noteEntries   LeadNote[]

  @@index([organizationId, status])
  @@index([organizationId, currentBrokerId])
  @@index([organizationId, createdAt])
  @@index([status, returnToRotationAt])
  @@index([status, remarketingNotifyAt])
  @@map("leads")
}

// ============================================================
// NOTAS DO LEAD (timeline)
// ============================================================

/// Timeline de notas de um lead. `kind`:
/// - "NOTE": nota adicionada pela janela "Ver Notas";
/// - "OBSERVATION": o campo de observação que já existia no card (leads.notes). A anotação
///   antiga de cada lead foi copiada para cá na migração (leads.notes continua intacto) e as
///   edições desse campo continuam sincronizadas com ele.
model LeadNote {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  leadId         String    @map("lead_id")
  authorUserId   String?   @map("author_user_id")
  kind           String    @default("NOTE")
  content        String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// Última modificação do conteúdo (nulo se nunca foi editada).
  editedAt       DateTime? @map("edited_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?              @relation("LeadNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  revisions    LeadNoteRevision[]

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@map("lead_notes")
}

/// Cada modificação de uma nota: conteúdo antes e depois, quem e quando. Nunca é apagada.
model LeadNoteRevision {
  id              String   @id @default(cuid())
  noteId          String   @map("note_id")
  previousContent String   @map("previous_content")
  newContent      String   @map("new_content")
  editedByUserId  String?  @map("edited_by_user_id")
  editedAt        DateTime @default(now()) @map("edited_at")

  note     LeadNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editedBy User?    @relation("LeadNoteEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@index([noteId, editedAt])
  @@map("lead_note_revisions")
}

model LeadAssignment {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  leadId         String           @map("lead_id")
  brokerId       String           @map("broker_id")
  attemptNumber  Int              @map("attempt_number")
  assignedAt     DateTime         @default(now()) @map("assigned_at")
  expiresAt      DateTime         @map("expires_at")
  respondedAt    DateTime?        @map("responded_at")
  status         AssignmentStatus @default(ASSIGNED)
  responseType   String?          @map("response_type")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker       Broker       @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([leadId, attemptNumber])
  @@index([status, expiresAt])
  @@index([organizationId, brokerId])
  @@map("lead_assignments")
}

model RotationState {
  id              String   @id @default(cuid())
  organizationId  String   @unique @map("organization_id")
  currentPosition Int      @default(1) @map("current_position")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rotation_state")
}

// ============================================================
// META INTEGRATION
// ============================================================

model MetaIntegration {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  pageId               String    @map("page_id")
  pageName             String?   @map("page_name")
  accessTokenEncrypted String    @map("access_token_encrypted")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  isActive             Boolean   @default(true) @map("is_active")
  lastEventAt          DateTime? @map("last_event_at")
  lastLeadSyncAt       DateTime? @map("last_lead_sync_at")
  webhookVerifiedAt    DateTime? @map("webhook_verified_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pageId])
  @@map("meta_integrations")
}

// ============================================================
// META ADS — acompanhamento de saldo/veiculação da conta de anúncio
// ============================================================

/// Uma conta de anúncio por organização, lida com token de usuário do sistema da BM do
/// cliente (nunca o token pessoal da agência). alertState guarda o que já foi avisado,
/// para o worker não repetir notificação (ver packages/db/src/meta-ads.ts).
model AdAccountMonitor {
  id                   String    @id @default(cuid())
  organizationId       String    @unique @map("organization_id")
  adAccountId          String    @map("ad_account_id")
  adAccountName        String?   @map("ad_account_name")
  accessTokenEncrypted String    @map("access_token_encrypted")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  dataAccessExpiresAt  DateTime? @map("data_access_expires_at")
  isActive             Boolean   @default(true) @map("is_active")
  alertState           Json      @default("{}") @map("alert_state")
  lastCheckAt          DateTime? @map("last_check_at")
  lastError            String?   @map("last_error")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ad_account_monitors")
}

// ============================================================
// WHATSAPP (Cloud API) — notificação de corretores
// ============================================================

model WhatsAppIntegration {
  id                   String    @id @default(cuid())
  organizationId       String    @unique @map("organization_id")
  phoneNumberId        String    @map("phone_number_id")
  displayPhoneNumber   String?   @map("display_phone_number")
  accessTokenEncrypted String    @map("access_token_encrypted")
  isActive             Boolean   @default(true) @map("is_active")
  lastMessageAt        DateTime? @map("last_message_at")
  lastErrorAt          DateTime? @map("last_error_at")
  lastError            String?   @map("last_error")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_integrations")
}

// ============================================================
// WEB PUSH — notificações mesmo com o CRM fechado (PWA)
// ============================================================

model PushSubscription {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?   @map("user_agent")
  lastSuccessAt  DateTime? @map("last_success_at")
  lastErrorAt    DateTime? @map("last_error_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  leadId         String?     @map("lead_id")
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String?     @map("entity_id")
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@map("audit_logs")
}

// ============================================================
// ÁREA DO CORRETOR — captação particular pelo Meta (módulo isolado)
// ============================================================
//
// Tudo aqui é independente da operação geral: os leads particulares NÃO ficam na tabela
// `leads`, então a roleta, os dashboards, os relatórios e o kanban geral nem os enxergam.
// O recebimento é feito por consulta periódica aos formulários do corretor (worker), sem
// passar pelo webhook geral nem exigir mudança no app da Meta. Lógica em
// packages/db/src/personal-leads.ts.

/// Quem pode usar a Área do Corretor. Fica numa tabela própria (e não numa coluna em
/// `brokers`) para nenhuma consulta existente de corretor depender desta migração.
model BrokerPersonalAccess {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  brokerId        String    @unique @map("broker_id")
  enabled         Boolean   @default(false)
  enabledAt       DateTime? @map("enabled_at")
  disabledAt      DateTime? @map("disabled_at")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker       Broker       @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("broker_personal_access")
}

/// Uma Página do Facebook do próprio corretor. `status`: ACTIVE | NEEDS_RECONNECT | ERROR |
/// DISCONNECTED. O token (de Página) fica sempre criptografado.
model BrokerMetaConnection {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  brokerId             String    @map("broker_id")
  name                 String
  accountOwnerName     String?   @map("account_owner_name")
  pageId               String    @unique @map("page_id")
  pageName             String?   @map("page_name")
  adAccountId          String?   @map("ad_account_id")
  adAccountName        String?   @map("ad_account_name")
  accessTokenEncrypted String    @map("access_token_encrypted")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  status               String    @default("ACTIVE")
  isActive             Boolean   @default(true) @map("is_active")
  lastSyncAt           DateTime? @map("last_sync_at")
  lastSyncError        String?   @map("last_sync_error")
  lastLeadAt           DateTime? @map("last_lead_at")
  createdByUserId      String?   @map("created_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker       Broker              @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  forms        BrokerMetaForm[]
  leads        PersonalLead[]
  syncLogs     BrokerMetaSyncLog[]

  @@index([organizationId, brokerId])
  @@index([isActive, status])
  @@map("broker_meta_connections")
}

/// Formulário de Lead Ads da Página do corretor. `syncCursor` = data do lead mais recente já
/// importado; a próxima consulta busca só o que veio depois (com uma margem de segurança).
model BrokerMetaForm {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  connectionId   String    @map("connection_id")
  formId         String    @map("form_id")
  formName       String?   @map("form_name")
  isActive       Boolean   @default(true) @map("is_active")
  syncCursor     DateTime? @map("sync_cursor")
  lastPolledAt   DateTime? @map("last_polled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   BrokerMetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, formId])
  @@index([organizationId])
  @@map("broker_meta_forms")
}

/// Lead da carteira particular de um corretor. Nunca entra na roleta nem é transferido.
/// Idempotência: (organization_id, meta_lead_id) é único.
model PersonalLead {
  id                  String     @id @default(cuid())
  organizationId      String     @map("organization_id")
  brokerId            String     @map("broker_id")
  connectionId        String?    @map("connection_id")
  sourceType          String     @default("BROKER_PERSONAL_META") @map("source_type")
  metaLeadId          String?    @map("meta_lead_id")
  name                String
  phone               String?
  email               String?
  platform            String?
  pageId              String?    @map("page_id")
  adAccountId         String?    @map("ad_account_id")
  campaignId          String?    @map("campaign_id")
  campaignName        String?    @map("campaign_name")
  adsetId             String?    @map("adset_id")
  adsetName           String?    @map("adset_name")
  adId                String?    @map("ad_id")
  adName              String?    @map("ad_name")
  formId              String?    @map("form_id")
  formName            String?    @map("form_name")
  customFields        Json       @default("{}") @map("custom_fields")
  rawData             Json       @default("{}") @map("raw_data")
  status              LeadStatus @default(NEW)
  remarketingNotifyAt DateTime?  @map("remarketing_notify_at")
  firstContactAt      DateTime?  @map("first_contact_at")
  convertedAt         DateTime?  @map("converted_at")
  /// Quando o lead foi gerado na Meta (created_time do formulário).
  createdAt           DateTime   @default(now()) @map("created_at")
  /// Quando o CRM importou o lead.
  receivedAt          DateTime   @default(now()) @map("received_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broker       Broker                @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  connection   BrokerMetaConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  notes        PersonalLeadNote[]
  events       PersonalLeadEvent[]

  @@unique([organizationId, metaLeadId])
  @@index([organizationId, brokerId, status])
  @@index([organizationId, brokerId, createdAt])
  @@index([status, remarketingNotifyAt])
  @@map("personal_leads")
}

model PersonalLeadNote {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  personalLeadId String   @map("personal_lead_id")
  authorUserId   String?  @map("author_user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         PersonalLead @relation(fields: [personalLeadId], references: [id], onDelete: Cascade)
  author       User?        @relation("PersonalLeadNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([personalLeadId, createdAt])
  @@index([organizationId])
  @@map("personal_lead_notes")
}

/// Histórico do lead particular. `type`: RECEIVED | STATUS_CHANGED | NOTE_ADDED |
/// REMINDER_SCHEDULED | REMINDER_SENT.
model PersonalLeadEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  personalLeadId String   @map("personal_lead_id")
  userId         String?  @map("user_id")
  type           String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         PersonalLead @relation(fields: [personalLeadId], references: [id], onDelete: Cascade)
  user         User?        @relation("PersonalLeadEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([personalLeadId, createdAt])
  @@index([organizationId])
  @@map("personal_lead_events")
}

/// Registro das sincronizações que trouxeram leads ou deram erro (as vazias não são gravadas,
/// para a tabela não crescer a cada minuto).
model BrokerMetaSyncLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  connectionId   String   @map("connection_id")
  trigger        String   @default("worker")
  leadsFound     Int      @default(0) @map("leads_found")
  leadsCreated   Int      @default(0) @map("leads_created")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   BrokerMetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([organizationId])
  @@map("broker_meta_sync_logs")
}
