DATABASE_URL="postgresql://postgres:SENHA@HOST.proxy.rlwy.net:PORTA/railway"
EXPIRATION_CHECK_INTERVAL_SECONDS=15

# Precisa ser IDÊNTICA à do app (Vercel) — o worker decifra tokens (Meta/WhatsApp)
# criptografados pelo app quando o dono conecta uma integração.
META_TOKEN_ENCRYPTION_KEY="mesma-chave-hex-de-64-caracteres-usada-no-app"

# Push "sua vez na roleta": quando o prazo de um corretor vence, é o worker que passa o
# lead para o próximo e dispara o push. Precisam ser as MESMAS chaves VAPID do app (Vercel),
# senão o push dessas passagens não sai (os aparelhos foram inscritos com a chave do app).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"

# Healthcheck do site de produção — roda neste worker (infra separada da Vercel, no
# Railway) porque se a Vercel cair/suspender por billing, algo hospedado NELA não
# conseguiria avisar ninguém. Se ficar fora do ar (402/5xx/timeout) por
# HEALTHCHECK_FAILURE_THRESHOLD checagens seguidas, envia um WhatsApp (reaproveitando a
# integração já conectada em /settings/integrations/whatsapp) e avisa de novo quando
# voltar ao normal. Requer aprovar os templates "crm_sistema_fora_do_ar" e
# "crm_sistema_recuperado" no WhatsApp Manager (ver README). Deixe
# HEALTHCHECK_ALERT_PHONE vazio para desativar.
HEALTHCHECK_URL="https://crmprospera.vercel.app"
HEALTHCHECK_INTERVAL_SECONDS=60
HEALTHCHECK_FAILURE_THRESHOLD=3
HEALTHCHECK_ALERT_PHONE="+5547997580595"
