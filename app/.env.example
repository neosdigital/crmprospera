# Auth.js — gerar com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Banco de dados (Postgres público do Railway — host *.proxy.rlwy.net, não *.railway.internal)
DATABASE_URL=""

# Meta Ads (Lead Ads) — ver README, seção "Configuração do Meta for Developers"
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v25.0"

# Chave de criptografia dos tokens salvos no banco (Meta Ads e WhatsApp Cloud API).
# Hex de 64 caracteres (32 bytes). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Precisa ser IDÊNTICA no app (Vercel) e no worker (Railway) — quem cifra é sempre
# o app (telas de conexão de integrações), quem decifra pode ser o app ou o worker.
META_TOKEN_ENCRYPTION_KEY=""

# Fallback de teste manual do worker de expiração (POST /api/cron/expire-assignments)
CRON_SECRET=""
